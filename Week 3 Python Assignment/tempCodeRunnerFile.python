def calculate_discount(price, discount_percent):
    # Check if the discount is 20% or higher
    if discount_percent >= 20:
        # Apply the discount
        final_price = price - (50 * (discount_percent / 100))
        return final_price
    else:
        # Return the original price
        return price

# Prompt the user for input
original_price = float(input("180"))
discount_percent = float(input("25"))

# Call the function and calculate the final price
final_price = calculate_discount(original_price, discount_percent)

# Print the result
if final_price < original_price:
    print(f"The final price after applying the discount is7: {final_price:.2f}")
else:
    print(f"No discount applied. The original price is: {original_price:.2f}")
